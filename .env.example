# Kopiera till .env.local och fyll i. Värdena finns i Supabase under Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Valfritt och bara för Claude Code (skillen kor-appen): ett testkonto i appen för att titta på sidorna efter inloggning.
# Börjar inte med VITE_, så det hamnar aldrig i webbläsarens kod, och är inte appens egna variabler (därför inte i vite-env.d.ts). Läggs inte i Vercel.
TESTKONTO_EPOST=
TESTKONTO_LOSENORD=
